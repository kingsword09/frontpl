{
  "name": "frontpl",
  "version": "0.6.4",
  "description": "Interactive CLI to scaffold standardized frontend project templates.",
  "keywords": [
    "cli",
    "frontend",
    "generator",
    "scaffold",
    "template"
  ],
  "homepage": "https://github.com/kingsword09/frontpl#readme",
  "bugs": {
    "url": "https://github.com/kingsword09/frontpl/issues"
  },
  "license": "MIT",
  "author": "Kingsword kingsword09 <kingsword09@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingsword09/frontpl.git"
  },
  "bin": {
    "frontpl": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "start": "node dist/cli.mjs",
    "typecheck": "vp check --no-fmt --no-lint",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "tiny-bin": "^2.0.0"
  },
  "devDependencies": {
    "@kingsword/lint-config": "^0.2.1",
    "@types/node": "^26.1.1",
    "oxlint": "^1.67.0",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.28.1"
}
